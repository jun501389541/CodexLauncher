{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-launcher:bridge:v1:usage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bridgeId",
    "providerId",
    "accountId",
    "displayName",
    "status",
    "quotaWindows",
    "updatedAt",
    "dataTimestamp",
    "sourceTimestamp",
    "isStale",
    "errorCode"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "bridgeId": {
      "type": "string"
    },
    "providerId": {
      "const": "codex"
    },
    "accountId": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "status": {
      "enum": [
        "OK",
        "STALE",
        "AUTH_REQUIRED",
        "NO_DATA",
        "NETWORK_ERROR",
        "UNSUPPORTED"
      ]
    },
    "quotaWindows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UsageWindow"
      }
    },
    "rateLimitResetCredits": {
      "description": "Optional reset-card details. availableCount is authoritative; credits=null means details are unavailable, while an empty array means the returned detail list is empty.",
      "$ref": "#/$defs/RateLimitResetCredits"
    },
    "rateLimitResetCreditsStatus": {
      "description": "Whether reset-credit data was returned in the source quota response and parsed successfully.",
      "enum": [
        "AVAILABLE",
        "NOT_RETURNED",
        "INVALID_FORMAT"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "dataTimestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "Z$"
    },
    "sourceTimestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "Z$"
    },
    "isStale": {
      "type": "boolean"
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "RateLimitResetCredits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availableCount",
        "credits"
      ],
      "properties": {
        "availableCount": {
          "type": "integer",
          "minimum": 0
        },
        "credits": {
          "description": "Null means no detail rows were returned; an empty array is a known empty detail list.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/RateLimitResetCredit"
          }
        }
      }
    },
    "RateLimitResetCredit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resetType",
        "status",
        "title",
        "description"
      ],
      "properties": {
        "resetType": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "expiresAt": {
          "description": "UTC timestamp, or null when the card has no expiry. Omitted when the source did not provide a usable expiry.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "UsageWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "usedPercent",
        "remainingPercent",
        "windowMinutes",
        "resetAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "usedPercent": {
          "type": [
            "number",
            "null"
          ]
        },
        "remainingPercent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "windowMinutes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "resetAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    }
  }
}
